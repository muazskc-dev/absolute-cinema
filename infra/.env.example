# ABSOLUTE-CINEMA server environment.
# Copy to infra/.env, fill secrets, chmod 600. Never commit this file.

NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=1

# Public DNS names
API_DOMAIN=api.example.com
TURN_REALM=turn.example.com

# Public IPv4 of the VPS (coturn external-ip)
PUBLIC_IPV4=203.0.113.10

# PostgreSQL (internal network only)
POSTGRES_DB=absolute_cinema
POSTGRES_USER=absolute_cinema
POSTGRES_PASSWORD=replace-with-openssl-rand-base64-36

# TURN shared secret (coturn use-auth-secret)
TURN_SECRET=replace-with-openssl-rand-base64-48

# Room and retention policy
ROOM_TTL_HOURS=24
CHAT_RETENTION_HOURS=24
MAX_ROOMS_PER_USER=10
